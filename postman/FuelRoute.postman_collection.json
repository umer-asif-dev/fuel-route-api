{
  "info": {
    "_postman_id": "22a64068-004e-468f-960e-277f340b4cb1",
    "name": "Fuel Route API",
    "description": "Cheapest fuel stops between two US locations (500 mi range, 10 MPG, empty tank at start).\n\nSet `baseUrl` (default http://127.0.0.1:8000). Run the folder **1. Trips** twice: the first run makes one OpenRouteService call per new trip, the second makes none (`meta.route_source = stored`).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "lastMapUrl",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Trips",
      "item": [
        {
          "name": "Short trip: Dallas -> Austin (one tank)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Gallons cover every mile (miles / 10)', () => pm.expect(body.fuel.total_gallons).to.be.closeTo(body.route.distance_miles / 10, 0.06));",
                  "pm.test('Total = sum of stops', () => pm.expect(body.fuel.total_cost).to.be.closeTo(body.fuel.stops.reduce((a, s) => a + s.cost, 0), 0.06));",
                  "pm.test('No stop more than one tank (500 mi) apart', () => { const m = body.fuel.stops.map(s => s.mile_marker); for (let i = 1; i < m.length; i++) pm.expect(m[i] - m[i-1]).to.be.at.most(525); pm.expect(body.route.distance_miles - m[m.length-1]).to.be.at.most(500.5); });",
                  "pm.test('Tank never over 50 gal', () => body.fuel.stops.forEach(s => pm.expect(s.fuel_on_arrival_gallons + s.gallons).to.be.at.most(50.01)));",
                  "pm.test('At most one routing API call', () => pm.expect(body.meta.external_calls).to.be.at.most(1));",
                  "console.log(`${body.start.label} -> ${body.finish.label}: ${body.route.distance_miles} mi, ${body.fuel.stop_count} stops, $${body.fuel.total_cost}, calls=${body.meta.external_calls} (${body.meta.route_source})`);",
                  "pm.collectionVariables.set('lastMapUrl', body.map_url);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/route/?start=Dallas, TX&finish=Austin, TX",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "route",
                ""
              ],
              "query": [
                {
                  "key": "start",
                  "value": "Dallas, TX"
                },
                {
                  "key": "finish",
                  "value": "Austin, TX"
                }
              ]
            },
            "description": ""
          }
        },
